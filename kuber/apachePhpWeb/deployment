# -------------------------------------------------------------
# Sample manifest for an Apache/PHP demo workload.
# Replace labels, images, and ownership fields before production.
# -------------------------------------------------------------
apiVersion: apps/v1
kind: Deployment
metadata:
  name: test-web-deployment-replicas
  labels:
    app: test-k8s-application
    env: prod
    owner: platform-team
spec:
  replicas: 1
  selector:
    matchLabels:
      project: t1
  template:
    metadata:
      labels:
        project: t1
    spec:
      containers:
        - name: t1-web
          image: registry.example.com/demo-web:latest
          imagePullPolicy: Always
          ports:
            - containerPort: 80
